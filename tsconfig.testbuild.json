{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "node",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "lib": [
      "ES2022",
      "DOM"
    ],
    "outDir": ".test-build",
    "rootDir": ".",
    "declaration": false
  },
  "include": [
    "frontend/runtime/library.ts",
    "frontend/runtime/native-toast-compat.ts",
    "frontend/runtime/outside-click.ts",
    "frontend/runtime/input-modality.ts",
    "frontend/state/service.ts",
    "frontend/state/customization-service.ts",
    "packages/core/src/**/*.ts",
    "packages/storage/src/**/*.ts",
    "packages/steam-adapter/src/**/*.ts",
    "packages/backup/src/**/*.ts",
    "packages/friends/src/**/*.ts",
    "packages/customization/src/**/*.ts"
  ]
}
